{
  "type": "module",
  "name": "cwd-common-app",
  "version": "0.8.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --aot",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "watch:crucible-common": "ng build crucible-common --watch",
    "link:crucible-common": "wait-on dist/@crucible-common/package.json && npm link dist/@crucible-common",
    "pack": "npm run build crucible-common --aot && cd dist/@crucible-common && npm pack",
    "build:clean": "rimraf dist",
    "build:link": "npm run build:clean && run-p watch:* link:crucible-common ",
    "json-server": "json-server ./projects/cwd-common-app/src/assets/db/db.json",
    "test:coverage": "ng test crucible-common --watch=false --configuration coverage"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/architect": "^0.2202.4",
    "@angular-devkit/core": ">=21.2.29",
    "@angular-devkit/schematics": ">=21.2.29",
    "@angular/animations": ">=21.2.0",
    "@angular/cdk": ">=21.2.14",
    "@angular/common": ">=21.2.25",
    "@angular/compiler": ">=21.2.25",
    "@angular/core": ">=21.2.25",
    "@angular/forms": ">=21.2.25",
    "@angular/material": ">=21.2.14",
    "@angular/platform-browser": ">=21.2.25",
    "@angular/router": ">=21.2.25",
    "@datorama/akita": "^8.0.0",
    "oidc-client-ts": "^2.4.0",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.4.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.29",
    "@angular/build": "^21.2.4",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/language-service": "^21.2.25",
    "@babel/core": "^7.14.8",
    "@datorama/akita-ngdevtools": "^6.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-loader": "^10.1.1",
    "codelyzer": "^6.0.2",
    "jsdom": "^29.1.1",
    "json-server": "^0.17.1",
    "ng-packagr": "^21.2.7",
    "npm-run-all": "^4.1.5",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.2",
    "tslint": "~6.1.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.9",
    "wait-on": "^9.5.1"
  }
}
